# The WordPress environment comes from the Homeboy wordpress extension:
# phpstan-wordpress, the WordPress and WP-CLI stubs, dynamicConstantNames, the
# shared ignoreErrors, and the core API overrides. This file carries only what
# is specific to this component.
#
# It previously opened with
#
#   includes:
#       - vendor/szepeviktor/phpstan-wordpress/extension.neon
#
# because declaring `level:` used to make the runner skip the extension config
# entirely. `vendor/` is gitignored, so wherever it was not installed PHPStan
# analysed with no WordPress signatures and reported correct core calls as
# defects. homeboy-extensions#2849 removed that coupling, so the include (and
# the duplicated require-dev behind it) is no longer needed.

parameters:
	level: 5
	paths:
		- inc
		- includes
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	treatPhpDocTypesAsCertain: false
	# tests/ defines simplified WordPress and sibling-plugin shims for a
	# standalone PHPUnit run. Their 0-arity stub signatures shadow the real
	# plugin signatures during analysis, so tests stay out of the analysis
	# scope, as they were before the extension environment was inherited.
	excludePaths:
		analyseAndScan:
			- %currentWorkingDirectory%/tests/*
