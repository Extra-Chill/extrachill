# End-user help must precede the docs/ and *.md exclusions (rsync first match wins).
# No trailing slash: Homeboy strips it before passing rules to rsync.
+ /docs
+ /docs/user
+ /docs/user/*.md

# Development files and directories to exclude from production build
node_modules/
vendor/
.git/
.gitignore
.DS_Store
.env

# Build system files
.buildignore
package.json
package-lock.json
composer.lock
webpack.config.js
gulpfile.js
vite.config.ts
tsconfig.json

# Documentation and development files
README.md
*.md
docs/
.github/
.vscode/
.idea/

# Testing files
tests/
phpunit.xml

# Development dependencies
src/
assets/src/
scss/
less/
coffee/