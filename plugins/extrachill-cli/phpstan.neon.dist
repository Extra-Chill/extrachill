# The events/venues/artists operator adapters call extrachill-events services
# and the extrachill-network genre resolver, which load on the owner site.
# The users wp-admin adapter calls the extrachill-users grant API.
# The calendar queries command uses the guarded analytics report API.
parameters:
	scanFiles:
		- ../extrachill-analytics/inc/core/calendar-query-report.php
		- ../extrachill-events/inc/core/genre-sync.php
		- ../extrachill-events/inc/Core/ArtistGenreClassifier.php
		- ../extrachill-events/inc/Core/EventSourceRampEvaluator.php
		- ../extrachill-events/inc/Core/FlowLocationRepairer.php
		- ../extrachill-events/inc/Core/GenreProjectionBackfill.php
		- ../extrachill-events/inc/Core/LocationIntegrityAuditor.php
		- ../extrachill-events/inc/Core/QualifyCohortDeriver.php
		- ../extrachill-events/inc/Core/QualifyStatsReport.php
		- ../extrachill-events/inc/Core/QualifyVerdict.php
		- ../extrachill-events/inc/Core/QualifyVerdictsTable.php
		- ../extrachill-events/inc/Core/RootLocationReconciler.php
		- ../extrachill-events/inc/Core/VenueRequalifier.php
		- ../extrachill-events/inc/Core/VenueTierClassifier.php
		- ../extrachill-network/inc/taxonomy/genre.php
		- ../extrachill-users/inc/wp-admin-permissions.php
