{
  "auto_cleanup": false,
  "changelog_target": "docs/CHANGELOG.md",
  "extensions": {
    "wordpress": {
      "settings": {
        "test_path_excludes": [
          "tests/integration/artist-dispatch-rest-smoke.php"
        ]
      }
    }
  },
  "id": "extrachill-blog",
  "remote_path": "wp-content/plugins/extrachill-blog",
  "version_targets": [
    {
      "file": "extrachill-blog.php",
      "pattern": "(?m)^\\s*\\*?\\s*Version:\\s*([0-9.]+)"
    },
    {
      "file": "extrachill-blog.php",
      "pattern": "EXTRACHILL_BLOG_VERSION',\\s*'([0-9.]+)'"
    }
  ]
}
