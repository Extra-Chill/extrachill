{
  "id": "extrachill-partner",
  "auto_cleanup": false,
  "extensions": {
    "wordpress": {
      "settings": {
        "wordpress_runtime_php_version": "8.4"
      }
    }
  },
  "version_targets": [
    {
      "file": "extrachill-partner.php",
      "pattern": "(?m)^\\s*\\*?\\s*Version:\\s*([0-9.]+)"
    },
    {
      "file": "readme.txt",
      "pattern": "(?m)^Stable tag:\\s*([0-9.]+)"
    }
  ]
}
