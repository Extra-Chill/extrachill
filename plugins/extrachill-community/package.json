{
  "name": "extrachill-community",
  "version": "1.2.3",
  "description": "Extra Chill community platform - WordPress theme for forums and community features",
  "main": "style.css",
  "scripts": {
    "build": "wp-scripts build --webpack-copy-php --experimental-modules",
    "start": "wp-scripts start --experimental-modules",
    "test:js": "wp-scripts test-unit-jest --runInBand",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "format": "wp-scripts format",
    "version": "grep -i 'Version:' style.css | head -1 | sed 's/.*Version:\\s*\\([0-9\\.]*\\).*/\\1/'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chubes4/extrachill-community.git"
  },
  "keywords": [
    "wordpress",
    "theme",
    "community",
    "forum",
    "bbpress",
    "music",
    "extrachill"
  ],
  "author": "Chris Huber <hello@chubes.net> (https://chubes.net)",
  "license": "GPL-2.0+",
  "bugs": {
    "url": "https://github.com/chubes4/extrachill-community/issues"
  },
  "homepage": "https://community.extrachill.com",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@wordpress/babel-preset-default": "^8.55.0",
    "@wordpress/jest-preset-default": "^14.2.0",
    "@wordpress/scripts": "^37.0.0",
    "ajv": "^8.20.0",
    "babel-jest": "^30.5.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@extrachill/components": "^0.9.4",
    "@extrachill/tokens": "^0.9.1",
    "@wordpress/api-fetch": "^7.0.0",
    "@wordpress/block-editor": "^14.0.0",
    "@wordpress/blocks": "^15.9.0",
    "@wordpress/components": "^28.0.0",
    "@wordpress/data": "^10.36.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/i18n": "^5.0.0",
    "@wordpress/icons": "^10.0.0",
    "@wordpress/url": "^4.57.0"
  },
  "private": true
}
