<?php
/**
 * PHPStan stub for the Extra Chill network contract (#446).
 *
 * Declarations only — never executed. Mirrors inc/core/blog-ids.php so that
 * components which call ec_get_blog_id() / ec_get_site_url() / EC_BLOG_ID_*
 * can analyse without hand-copying signatures. It also declares the public
 * artist identity API from inc/core/artist-identity.php. Keep in lockstep with
 * both files; tests/network-contract-support-smoke.php fails when a
 * function, parameter or constant value drifts.
 *
 * Usage (phpstan.neon in a sibling component):
 *
 *     parameters:
 *         scanFiles:
 *             - ../extrachill-network/tests/support/phpstan-network-contract.stub
 *
 * @package ExtraChillNetwork
 */

