{
  "auto_cleanup": false,
  "changelog_target": "docs/CHANGELOG.md",
  "extensions": {
    "wordpress": {
      "settings": {
        "standalone_php_test_paths": [
          "tests/smoke-*.php"
        ],
        "validation_dependencies": [
          "extrachill-network"
        ]
      }
    }
  },
  "id": "extrachill-news-wire",
  "remote_path": "wp-content/plugins/extrachill-news-wire",
  "version_targets": [
    {
      "file": "extrachill-news-wire.php",
      "pattern": "(?m)^\\s*\\*?\\s*Version:\\s*([0-9.]+)"
    }
  ]
}
