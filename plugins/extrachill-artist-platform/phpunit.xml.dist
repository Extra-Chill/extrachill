<?xml version="1.0" encoding="UTF-8"?>
<phpunit colors="true">
	<!--
		Executed through the Homeboy managed WordPress harness (see homeboy.json).
		The harness owns the WordPress bootstrap: no bootstrap attribute, no
		repo-local WordPress simulation.
	-->
	<testsuites>
		<testsuite name="Extra Chill Artist Platform">
			<directory suffix="Test.php">tests</directory>
			<exclude>tests/MySQLIntegration</exclude>
		</testsuite>
	</testsuites>
	<groups>
		<exclude>
			<group>requires-mysql</group>
		</exclude>
	</groups>
</phpunit>
