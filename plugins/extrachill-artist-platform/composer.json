{
    "name": "chubes4/extrachill-artist-platform",
    "description": "WordPress plugin providing comprehensive artist platform functionality for the Extra Chill community",
    "type": "wordpress-plugin",
    "license": "GPL-2.0+",
    "authors": [
        {
            "name": "Chris Huber",
            "email": "hello@chubes.net",
            "homepage": "https://chubes.net"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "psr-4": {
            "ExtraChillArtistPlatform\\": "inc/"
        }
    },
    "scripts": {
        "test": "homeboy review test extrachill-artist-platform",
        "lint:php": "homeboy extension exec wordpress -- \"$HOMEBOY_EXTENSION_PATH/vendor/bin/phpcs\" --standard='$HOMEBOY_EXTENSION_PATH/rulesets/homeboy-wordpress-project.xml' .",
        "lint:fix": "homeboy extension exec wordpress -- \"$HOMEBOY_EXTENSION_PATH/vendor/bin/phpcbf\" --standard='$HOMEBOY_EXTENSION_PATH/rulesets/homeboy-wordpress-project.xml' ."
    }
}
