# The WordPress environment comes from the Homeboy wordpress extension:
# phpstan-wordpress, the WordPress and WP-CLI stubs, dynamicConstantNames, the
# shared ignoreErrors, and the core API overrides. This file carries only what
# is specific to this component.
#
# It previously opened with
#
#   includes:
#       - vendor/szepeviktor/phpstan-wordpress/extension.neon
#
# because declaring `level:` used to make the runner skip the extension config
# entirely. `vendor/` is gitignored, so wherever it was not installed PHPStan
# analysed with no WordPress signatures and reported correct core calls as
# defects — 211 findings, none of them real. homeboy-extensions#2849 removed
# that coupling, so the include (and the duplicated require-dev behind it) is
# no longer needed.

parameters:
	level: 5
	treatPhpDocTypesAsCertain: false
	# Production runs PHP 8.4. Allow PHPStan to recognise native PHP 8.0+
	# union types (e.g. `null|WP_Error`) and matching narrowing semantics.
	phpVersion: 80000
	excludePaths:
		analyseAndScan:
			- %currentWorkingDirectory%/../extrachill-network/tests/*
			- %currentWorkingDirectory%/../extrachill-api/tests/*
	ignoreErrors:
		-
			identifier: require.fileNotFound
			path: inc/concert-tracking/buttons.php
			count: 1
	paths:
		- inc
		- blocks
	scanFiles:
		- extrachill-users.php
		# Constants owned by sibling Extra Chill plugins, not by WordPress.
		- tests/phpstan-stubs.php
