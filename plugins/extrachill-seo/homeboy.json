{
  "auto_cleanup": false,
  "changelog_target": "docs/CHANGELOG.md",
  "extensions": {
    "wordpress": {
      "settings": {
        "local_workspace_dependencies": [
          { "name": "@extrachill/components", "path": "../../packages/components" }
        ],
        "validation_dependencies": [
          "extrachill-network"
        ],
        "wordpress_runtime_php_version": "8.4"
      }
    }
  },
  "id": "extrachill-seo",
  "remote_path": "wp-content/plugins/extrachill-seo",
  "version_targets": [
    {
      "file": "extrachill-seo.php",
      "pattern": "(?m)^\\s*\\*?\\s*Version:\\s*([0-9.]+)"
    },
    {
      "file": "extrachill-seo.php",
      "pattern": "EXTRACHILL_SEO_VERSION',\\s*'([0-9.]+)'"
    }
  ]
}
