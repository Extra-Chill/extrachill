{
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@wordpress/api-fetch": "^8.0.0",
    "@wordpress/babel-preset-default": "^8.55.0",
    "@wordpress/block-editor": "^15.23.0",
    "@wordpress/blocks": "^15.23.0",
    "@wordpress/components": "^36.1.0",
    "@wordpress/element": "^8.2.0",
    "@wordpress/hooks": "^3.58.0",
    "@wordpress/jest-preset-default": "^14.2.0",
    "@wordpress/scripts": "^37.0.0",
    "ajv": "^8.20.0",
    "babel-jest": "^30.5.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@extrachill/components": "^0.9.4"
  },
  "name": "extrachill-booking",
  "scripts": {
    "build": "npm run build:venue-settings && npm run build:venue-booking-inquiry && npm run copy:venue-booking-inquiry",
    "build:venue-settings": "wp-scripts build blocks/venue-settings/src/booking-settings.js --output-path=build/venue-settings",
    "build:venue-booking-inquiry": "wp-scripts build blocks/venue-booking-inquiry/src/index.js blocks/venue-booking-inquiry/src/view.js --output-path=build/venue-booking-inquiry",
    "copy:venue-booking-inquiry": "cp blocks/venue-booking-inquiry/block.json blocks/venue-booking-inquiry/render.php build/venue-booking-inquiry/",
    "test:js": "wp-scripts test-unit-jest"
  }
}
