{
  "auto_cleanup": false,
  "changelog_target": "docs/CHANGELOG.md",
  "extensions": {
    "wordpress": {
      "php": "8.4",
      "database_type": "mysql",
      "settings": {
        "wordpress_runtime_php_version": "8.4",
        "wp_codebox_multisite": true,
        "wp_codebox_phpunit_bootstrap_mode": "managed",
        "wp_codebox_phpunit_suites": [
          {
            "name": "booking-mysql",
            "config": "phpunit-booking-mysql.xml.dist",
            "runtime": "sandbox",
            "preload_files": [
              "/wordpress/wp-content/plugins/extrachill-booking/tests/MySQLIntegration/booking-schema-multisite-bootstrap.php",
              "/wordpress/wp-content/plugins/extrachill-booking/tests/MySQLIntegration/booking-attachment-mysql-bootstrap.php",
              "/wordpress/wp-content/plugins/extrachill-booking/tests/bootstrap.php"
            ]
          },
          {
            "name": "booking-concurrency",
            "config": "phpunit-booking-concurrency.xml.dist",
            "runtime": "sandbox",
            "preload_files": [
              "/wordpress/wp-content/plugins/extrachill-booking/tests/MySQLIntegration/booking-schema-multisite-bootstrap.php",
              "/wordpress/wp-content/plugins/extrachill-booking/tests/MySQLIntegration/booking-attachment-mysql-bootstrap.php",
              "/wordpress/wp-content/plugins/extrachill-booking/tests/bootstrap.php"
            ]
          },
          {
            "name": "booking-alpha",
            "config": "phpunit-booking-alpha.xml.dist",
            "runtime": "sandbox",
            "preload_files": [
              "/wordpress/wp-content/plugins/extrachill-booking/tests/MySQLIntegration/booking-schema-multisite-bootstrap.php",
              "/wordpress/wp-content/plugins/extrachill-booking/tests/MySQLIntegration/internal-booking-alpha-bootstrap.php",
              "/wordpress/wp-content/plugins/extrachill-booking/tests/bootstrap.php"
            ]
          },
          {
            "name": "booking-alpha-concurrency",
            "config": "phpunit-booking-alpha-concurrency.xml.dist",
            "runtime": "sandbox",
            "preload_files": [
              "/wordpress/wp-content/plugins/extrachill-booking/tests/MySQLIntegration/booking-schema-multisite-bootstrap.php",
              "/wordpress/wp-content/plugins/extrachill-booking/tests/MySQLIntegration/internal-booking-alpha-bootstrap.php",
              "/wordpress/wp-content/plugins/extrachill-booking/tests/bootstrap.php"
            ]
          },
          {
            "name": "artist-booking-inquiry",
            "config": "phpunit-artist-booking-inquiry.xml.dist",
            "runtime": "host"
          }
        ],
        "validation_dependencies": [
          "extrachill-events",
          "extrachill-network"
        ],
        "local_workspace_dependencies": [
          {
            "name": "@extrachill/components",
            "path": "../../packages/components"
          }
        ],
        "wp_codebox_database_service": {
          "provider": "external",
          "engine": "mysql",
          "allowed_hosts": [
            "127.0.0.1:3306"
          ],
          "secret_env": {
            "host": "WP_CODEBOX_DB_HOST",
            "port": "WP_CODEBOX_DB_PORT",
            "username": "WP_CODEBOX_DB_USER",
            "password": "WP_CODEBOX_DB_PASSWORD"
          }
        }
      }
    }
  },
  "id": "extrachill-booking",
  "remote_path": "wp-content/plugins/extrachill-booking",
  "version_targets": [
    {
      "file": "extrachill-booking.php",
      "pattern": "(?m)^\\s*\\*?\\s*Version:\\s*([0-9.]+)"
    }
  ]
}
