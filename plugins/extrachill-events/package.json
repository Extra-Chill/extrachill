{
	"name": "extrachill-events",
	"version": "0.3.3",
	"description": "ExtraChill Events block tooling",
	"private": true,
	"scripts": {
		"build": "npm run build:event-submission && npm run build:concert-stats && npm run build:venue-settings && npm run build:venue-booking-inquiry && npm run copy:block-files",
		"build:event-submission": "wp-scripts build blocks/event-submission/src/index.js --output-path=build/event-submission",
		"build:concert-stats": "wp-scripts build blocks/concert-stats/src/index.js blocks/concert-stats/src/view.js --output-path=build/concert-stats",
		"build:venue-settings": "wp-scripts build blocks/venue-settings/src/index.js blocks/venue-settings/src/view.js --output-path=build/venue-settings",
		"build:venue-booking-inquiry": "wp-scripts build blocks/venue-booking-inquiry/src/index.js blocks/venue-booking-inquiry/src/view.js --output-path=build/venue-booking-inquiry",
		"copy:block-files": "npm run copy:event-submission && npm run copy:concert-stats && npm run copy:venue-settings && npm run copy:venue-booking-inquiry",
		"copy:event-submission": "cp blocks/event-submission/block.json blocks/event-submission/render.php blocks/event-submission/style.css blocks/event-submission/view.js build/event-submission/",
		"copy:concert-stats": "cp blocks/concert-stats/block.json blocks/concert-stats/render.php build/concert-stats/",
		"copy:venue-settings": "cp blocks/venue-settings/block.json blocks/venue-settings/render.php build/venue-settings/",
		"copy:venue-booking-inquiry": "cp blocks/venue-booking-inquiry/block.json blocks/venue-booking-inquiry/render.php build/venue-booking-inquiry/",
		"start": "wp-scripts start blocks/event-submission/src/index.js --output-path=build/event-submission",
		"start:concert-stats": "wp-scripts start blocks/concert-stats/src/index.js blocks/concert-stats/src/view.js --output-path=build/concert-stats",
		"test:js": "wp-scripts test-unit-js",
		"test:browser:near-me": "node tests/browser/near-me.evidence.js",
		"test:browser:vendor-request": "node tests/browser/vendor-request.evidence.js",
		"test:browser:booking-inquiry": "node tests/browser/booking-inquiry.evidence.js",
		"test:browser:booking-form-preview": "node tests/browser/booking-form-preview.evidence.js",
		"test:browser:booking-setup-copy": "node tests/browser/booking-setup-copy.evidence.js",
		"test:browser:booking-embed": "node tests/browser/booking-embed.evidence.js",
		"test:browser:booking-correspondence": "node tests/browser/booking-correspondence.evidence.js",
		"test:browser:city-calendar-priority": "node tests/browser/city-calendar-priority.evidence.js",
		"test:browser:venue-claim-acquisition": "node tests/browser/venue-claim-acquisition.evidence.js",
		"test:browser:my-shows-registration": "node tests/browser/my-shows-registration.evidence.js",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix"
	},
	"devDependencies": {
		"@wordpress/block-editor": "^15.23.0",
		"@wordpress/blocks": "^15.23.0",
		"@wordpress/components": "^36.1.0",
		"@wordpress/element": "^8.2.0",
		"@wordpress/scripts": "^27.1.0",
		"ajv": "^8.20.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"dependencies": {
		"@extrachill/components": "^0.9.3"
	}
}
