<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" beStrictAboutOutputDuringTests="true" beStrictAboutTestsThatDoNotTestAnything="true" failOnRisky="true" failOnWarning="true">
	<testsuites>
		<!--
			submit-landing-unit: pure-PHP unit tests for the /submit landing
			section (#959). Uses file-level WP doubles, so it runs on the host
			runtime with no WordPress loaded.
		-->
		<testsuite name="submit-landing-unit">
			<file>tests/Unit/Core/SubmitLandingTest.php</file>
		</testsuite>
	</testsuites>
</phpunit>
