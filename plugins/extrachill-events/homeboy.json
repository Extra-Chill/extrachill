{
  "auto_cleanup": false,
  "changelog_target": "docs/CHANGELOG.md",
  "extensions": {
    "wordpress": {
      "php": "8.3",
      "database_type": "mysql",
      "settings": {
        "wp_codebox_database_service": {
          "provider": "external",
          "engine": "mysql",
          "allowed_hosts": [
            "127.0.0.1:3306"
          ],
          "secret_env": {
            "host": "WP_CODEBOX_DB_HOST",
            "port": "WP_CODEBOX_DB_PORT",
            "username": "WP_CODEBOX_DB_USER",
            "password": "WP_CODEBOX_DB_PASSWORD"
          }
        },
        "wp_codebox_multisite": true,
        "wp_codebox_phpunit_bootstrap_mode": "managed",
        "wp_codebox_phpunit_suites": [
          {
            "name": "booking-mysql",
            "config": "phpunit-booking-mysql.xml.dist"
          },
          {
            "name": "booking-concurrency",
            "config": "phpunit-booking-concurrency.xml.dist"
          },
          {
            "name": "managed-wordpress",
            "config": "phpunit-managed.xml.dist"
          },
          {
            "name": "membership",
            "config": "phpunit-membership.xml.dist"
          },
          {
            "name": "promoter-authority",
            "config": "phpunit-promoter-authority.xml.dist"
          },
          {
            "name": "booking-alpha",
            "config": "phpunit-booking-alpha.xml.dist"
          },
          {
            "name": "booking-alpha-concurrency",
            "config": "phpunit-booking-alpha-concurrency.xml.dist"
          }
        ],
        "wp_config_defines": {
          "EC_LINK_PAGE_STORAGE_BLOG_ID": 1
        },
        "validation_dependencies": [
          "data-machine",
          "data-machine-events",
          "data-machine-socials",
          "extrachill-api",
          "extrachill-newsletter",
          "extrachill-link-pages",
          "extrachill-network",
          "extrachill-users"
        ],
        "wp_codebox_phpunit_preload_files": [
          "/wordpress/wp-content/plugins/extrachill-events/tests/MySQLIntegration/booking-schema-multisite-bootstrap.php"
        ]
      }
    }
  },
  "id": "extrachill-events",
  "remote_path": "wp-content/plugins/extrachill-events",
  "version_targets": [
    {
      "file": "extrachill-events.php",
      "pattern": "(?m)^\\s*\\*?\\s*Version:\\s*([0-9.]+)"
    },
    {
      "file": "extrachill-events.php",
      "pattern": "EXTRACHILL_EVENTS_VERSION',\\s*'([0-9.]+)'"
    },
    {
      "file": "extrachill-events-network-blocks.php",
      "pattern": "(?m)^\\s*\\*?\\s*Version:\\s*([0-9.]+)"
    },
    {
      "file": "blocks/concert-stats/block.json",
      "pattern": "\"version\":\\s*\"([0-9.]+)\"",
      "artifact_path": "build/concert-stats/block.json"
    },
    {
      "file": "blocks/event-submission/block.json",
      "pattern": "\"version\":\\s*\"([0-9.]+)\"",
      "artifact_path": "build/event-submission/block.json"
    }
  ]
}
