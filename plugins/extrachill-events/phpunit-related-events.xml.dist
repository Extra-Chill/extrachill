<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" beStrictAboutOutputDuringTests="true" beStrictAboutTestsThatDoNotTestAnything="true" failOnRisky="true" failOnWarning="true">
	<testsuites>
		<!--
			related-events: pure-PHP unit tests for the single-event related
			sections. This suite owns its file-level WP doubles because sibling
			pure suites define the same symbols; a shared suite would make
			whichever file loads first win.
		-->
		<testsuite name="related-events">
			<file>tests/Unit/RelatedEventsRenderTest.php</file>
		</testsuite>
	</testsuites>
</phpunit>
