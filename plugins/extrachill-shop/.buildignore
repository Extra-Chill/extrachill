# End-user help must precede the docs/ exclusion (rsync first match wins).
# No trailing slash: Homeboy strips it before passing rules to rsync.
+ /docs
+ /docs/user
+ /docs/user/*.md

# Development files
node_modules/
.git/
.github/
/docs/***

# Build files
build/
.buildignore
composer.lock
package-lock.json

# IDE files
.vscode/
.idea/
*.swp
*.swo

# System files
.DS_Store
.htaccess
Thumbs.db

# Local environment
.env
.env.local

# Documentation
README.md
CHANGELOG.md

# Testing
tests/
phpunit.xml
.phpunit.result.cache

# Claude specific
.claude/
