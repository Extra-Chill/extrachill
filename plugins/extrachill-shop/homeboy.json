{
  "id": "extrachill-shop",
  "changelog_target": "docs/CHANGELOG.md",
  "extensions": {
    "wordpress": {
      "settings": {
        "local_workspace_dependencies": [
          {
            "name": "@extrachill/components",
            "path": "../../packages/components"
          }
        ]
      }
    }
  },
  "version_targets": [
    {
      "file": "extrachill-shop.php",
      "pattern": "Version:\\s*([\\d.]+)"
    },
    {
      "file": "extrachill-shop.php",
      "pattern": "EXTRACHILL_SHOP_VERSION',\\s*'([\\d.]+)"
    },
    {
      "file": "src/blocks/shop-manager/block.json",
      "pattern": "\"version\":\\s*\"([0-9.]+)\"",
      "artifact_path": "build/blocks/shop-manager/block.json"
    }
  ],
  "scopes": {
    "release": {
      "exclude": [
        ".vscode/**",
        "src/**",
        "webpack.config.js"
      ]
    }
  }
}
