on:has-text(\\\"My posts\\\")\",\"state\":\"attached\"},{\"kind\":\"screenshot\",\"name\":\"social-manager-complete\"}]"
        ]
      },
      {
        "command": "wordpress.browser-actions",
        "args": [
          "auth=wordpress-admin",
          "auth-user-id=101",
          "url=/studio-persona/",
          "capture=steps,console,errors,html,screenshot,dom-snapshot",
          "steps-json=[{\"kind\":\"navigate\",\"url\":\"/studio-persona/\",\"waitFor\":\"load\"},{\"kind\":\"waitFor\",\"selector\":\"[data-ec-studio-root][data-ec-studio-mounted=\\\"true\\\"]\"},{\"kind\":\"click\",\"selector\":\".ec-tabs__tab:has-text(\\\"Socials\\\")\"},{\"kind\":\"waitFor\",\"selector\":\".ec-studio-socials-layout\"},{\"kind\":\"expect\",\"selector\":\".ec-socials-sidebar__platform:has-text(\\\"Instagram\\\")\",\"state\":\"visible\"},{\"kind\":\"expect\",\"selector\":\".ec-socials-sidebar__platform:has-text(\\\"Facebook\\\")\",\"state\":\"visible\"},{\"kind\":\"expect\",\"selector\":\".ec-socials-sidebar__platform:has-text(\\\"X / Twitter\\\")\",\"state\":\"visible\"},{\"kind\":\"expect\",\"selector\":\".ec-socials-sidebar__platform:has-text(\\\"Bluesky\\\")\",\"state\":\"visible\"},{\"kind\":\"expect\",\"selector\":\".ec-socials-sidebar__platform:has-text(\\\"Threads\\\")\",\"state\":\"visible\"},{\"kind\":\"expect\",\"selector\":\".ec-socials-sidebar__platform:has-text(\\\"Pinterest\\\")\",\"state\":\"visible\"},{\"kind\":\"expect\",\"selector\":\".ec-socials-sidebar__platform:has-text(\\\"LinkedIn\\\")\",\"state\":\"visible\"},{\"kind\":\"expect\",\"selector\":\".ec-socials-sidebar__platform:has-text(\\\"Mastodon\\\")\",\"state\":\"visible\"},{\"kind\":\"expect\",\"selector\":\".ec-socials-sidebar__platform:has-text(\\\"Tumblr\\\")\",\"state\":\"visible\"},{\"kind\":\"expect\",\"selector\":\".ec-socials-sidebar__platform:has-text(\\\"TikTok\\\")\",\"state\":\"visible\"},{\"kind\":\"expect\",\"selector\":\".ec-socials-sidebar__platform:has-text(\\\"YouTube\\\")\",\"state\":\"visible\"},{\"kind\":\"click\",\"selector\":\".ec-socials-sidebar__platform-header:has-text(\\\"YouTube\\\")\"},{\"kind\":\"expect\",\"selector\":\"#ec-studio-youtube-caption\",\"state\":\"visible\"},{\"kind\":\"screenshot\",\"name\":\"all-social-platforms\"}]"
        ]
      },
      {
        "command": "wordpress.browser-actions",
        "args": [
          "auth=wordpress-admin",
          "auth-user-id=102",
          "url=/studio-persona/",
          "capture=steps,console,errors,html,screenshot,dom-snapshot",
          "steps-json=[{\"kind\":\"navigate\",\"url\":\"/studio-persona/\",\"waitFor\":\"load\"},{\"kind\":\"waitFor\",\"selector\":\"[data-ec-studio-root][data-ec-studio-mounted=\\\"true\\\"]\"},{\"kind\":\"expect\",\"selector\":\".ec-tabs__tab:has-text(\\\"Blog\\\")\",\"state\":\"visible\"},{\"kind\":\"expect\",\"selector\":\".ec-tabs__tab:has-text(\\\"Socials\\\")\",\"state\":\"detached\"},{\"kind\":\"expect\",\"selector\":\".ec-tabs__tab:has-text(\\\"Network\\\")\",\"state\":\"visible\"},{\"kind\":\"screenshot\",\"name\":\"ordinary-team-boundary\"}]"
        ]
      },
      {
        "command": "wordpress.run-php",
        "args": [
          "code=$reply = get_option( 'studio_persona_last_reply', '' ); if ( 'Thanks for supporting local music. See you there!' !== $reply ) { throw new RuntimeException( 'Social reply fixture effect was not recorded.' ); } echo wp_json_encode( array( 'reply_recorded' => true ) );"
        ]
      }
    ]
