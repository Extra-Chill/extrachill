{
  "auto_cleanup": false,
  "changelog_target": "docs/CHANGELOG.md",
  "extensions": {
    "wordpress": {}
  },
  "id": "extrachill-newsletter",
  "remote_path": "wp-content/plugins/extrachill-newsletter",
  "version_targets": [
    {
      "file": "extrachill-newsletter.php",
      "pattern": "(?m)^\\s*\\*?\\s*Version:\\s*([0-9.]+)"
    },
    {
      "file": "extrachill-newsletter.php",
      "pattern": "EXTRACHILL_NEWSLETTER_VERSION',\\s*'([0-9.]+)'"
    }
  ],
  "self_checks": {
    "test": [
      "php tests/delegated-campaign-owner-smoke.php",
      "php tests/delegated-campaign-task-smoke.php",
      "php tests/newsletter-form-tracking-smoke.php",
      "php tests/sendy-campaign-consumer-smoke.php",
      "php tests/sendy-single-config-smoke.php",
      "php tests/optional-ability-input-smoke.php"
    ]
  }
}
