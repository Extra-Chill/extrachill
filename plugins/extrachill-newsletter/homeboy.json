{
  "auto_cleanup": false,
  "changelog_target": "docs/CHANGELOG.md",
  "extensions": {
    "wordpress": {
      "settings": {
        "wp_codebox_phpunit_bootstrap_mode": "managed",
        "wp_codebox_multisite": true,
        "wordpress_runtime_php_version": "8.4",
        "validation_dependencies": [
          "extrachill-network",
          "data-machine"
        ],
        "wp_config_defines": {
          "EC_BLOG_ID_NEWSLETTER": 1,
          "EC_BLOG_ID_EVENTS": 1
        },
        "wp_codebox_phpunit_preload_files": [
          "/wordpress/wp-content/plugins/extrachill-newsletter/tests/bootstrap-integration.php"
        ]
      }
    }
  },
  "id": "extrachill-newsletter",
  "remote_path": "wp-content/plugins/extrachill-newsletter",
  "version_targets": [
    {
      "file": "extrachill-newsletter.php",
      "pattern": "(?m)^\\s*\\*?\\s*Version:\\s*([0-9.]+)"
    },
    {
      "file": "extrachill-newsletter.php",
      "pattern": "EXTRACHILL_NEWSLETTER_VERSION',\\s*'([0-9.]+)'"
    }
  ],
  "self_checks": {
    "test": [
      "php tests/delegated-campaign-owner-smoke.php",
      "php tests/delegated-campaign-task-smoke.php",
      "php tests/newsletter-form-tracking-smoke.php",
      "php tests/email-plain-text-smoke.php",
      "php tests/sendy-campaign-consumer-smoke.php",
      "php tests/sendy-single-config-smoke.php",
      "php tests/member-subscriptions-smoke.php",
      "php tests/optional-ability-input-smoke.php",
      "php tests/newsletter-link-tagging-smoke.php"
    ]
  }
}
