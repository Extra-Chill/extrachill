{
  "auto_cleanup": false,
  "changelog_target": "CHANGELOG.md",
  "extensions": {
    "nodejs": {
      "settings": {
        "local_workspace_dependencies": [
          { "name": "@extrachill/tokens", "path": "../tokens" }
        ]
      }
    }
  },
  "id": "extrachill-components",
  "release": {
    "publish": false
  },
  "remote_path": "",
  "version_targets": [
    {
      "file": "package.json",
      "pattern": "\"version\":\\s*\"([0-9.]+)\""
    }
  ]
}