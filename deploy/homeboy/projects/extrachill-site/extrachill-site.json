{
  "domain": "extrachill.com",
  "server_id": "hetzner",
  "base_path": "/var/www/extrachill.com",
  "path_roots": {
    "wp_content": "wp-content"
  },
  "remote_files": {
    "pinned_files": []
  },
  "remote_logs": {
    "pinned_logs": [
      {
        "path": "wp-content/debug.log",
        "label": "WordPress Debug Log",
        "tail_lines": 100
      },
      {
        "path": "/var/log/nginx/access.log",
        "label": "Nginx Access Log",
        "tail_lines": 200
      },
      {
        "path": "/var/log/nginx/error.log",
        "label": "Nginx Error Log",
        "tail_lines": 200
      },
      {
        "path": "/var/log/php8.4-fpm.log",
        "label": "PHP-FPM Log",
        "tail_lines": 100
      },
      {
        "path": "/var/log/syslog",
        "label": "System Log",
        "tail_lines": 100
      },
      {
        "path": "/var/log/mariadb/error.log",
        "label": "MariaDB Error Log",
        "tail_lines": 100
      },
      {
        "path": "/var/log/mysql/slow.log",
        "label": "MariaDB Slow Query Log",
        "tail_lines": 200
      },
      {
        "path": "/root/.kimaki/kimaki.log",
        "label": "Kimaki Bot Log",
        "tail_lines": 200
      }
    ]
  },
  "database": {
    "host": "localhost",
    "port": 3306,
    "name": "",
    "user": "",
    "use_ssh_tunnel": true
  },
  "api": {
    "enabled": false,
    "base_url": ""
  },
  "sub_targets": [],
  "shared_tables": [],
  "components": [
    {
      "id": "markdown-database-integration",
      "remote_path": "wp-content/plugins/markdown-database-integration",
      "local_path": ""
    },
    {
      "id": "blocks-everywhere",
      "remote_path": "wp-content/plugins/blocks-everywhere",
      "local_path": ""
    },
    {
      "id": "data-machine",
      "remote_path": "wp-content/plugins/data-machine",
      "local_path": ""
    },
    {
      "id": "data-machine-business",
      "remote_path": "wp-content/plugins/data-machine-business",
      "local_path": ""
    },
    {
      "id": "data-machine-events",
      "remote_path": "wp-content/plugins/data-machine-events",
      "local_path": ""
    },
    {
      "id": "data-machine-socials",
      "remote_path": "wp-content/plugins/data-machine-socials",
      "local_path": ""
    },
    {
      "id": "extrachill-admin-tools",
      "remote_path": "wp-content/plugins/extrachill-admin-tools",
      "local_path": ""
    },
    {
      "id": "wp-codebox",
      "remote_path": "wp-content/plugins/wp-codebox",
      "local_path": ""
    }
  ],
  "hooks": {
    "post:deploy:project": [
      "wp extrachill-cache purge --all --path={{base_path}}"
    ]
  }
}
