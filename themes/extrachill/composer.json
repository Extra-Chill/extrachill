{
    "name": "extrachill/extrachill-theme",
    "description": "ExtraChill WordPress theme for independent music ecosystem",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Chris Huber",
            "email": "chris@extrachill.com",
            "homepage": "https://chubes.net"
        }
    ],
    "require": {
        "php": ">=7.4",
        "composer/installers": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "lint:php": "homeboy extension exec wordpress -- '$HOMEBOY_EXTENSION_PATH/vendor/bin/phpcs' --standard='$HOMEBOY_EXTENSION_PATH/rulesets/homeboy-wordpress-project.xml' .",
        "lint:fix": "homeboy extension exec wordpress -- '$HOMEBOY_EXTENSION_PATH/vendor/bin/phpcbf' --standard='$HOMEBOY_EXTENSION_PATH/rulesets/homeboy-wordpress-project.xml' .",
        "test": "homeboy review test extrachill"
    },
    "extra": {
        "installer-name": "extrachill"
    }
}
