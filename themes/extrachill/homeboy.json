{
  "auto_cleanup": false,
  "changelog_target": "docs/CHANGELOG.md",
  "extensions": {
    "wordpress": {
      "settings": {
        "local_workspace_dependencies": [
          { "name": "@extrachill/tokens", "path": "../../packages/tokens" }
        ]
      }
    }
  },
  "id": "extrachill",
  "remote_path": "wp-content/themes/extrachill",
  "version_targets": [
    {
      "file": "style.css",
      "pattern": "(?m)^\\s*Version:\\s*([0-9.]+)"
    },
    {
      "file": "package.json",
      "pattern": "\"version\":\\s*\"([0-9.]+)\""
    }
  ],
  "self_checks": {
    "test": [
      "php tests/comments-section-hook.php",
      "php tests/comments-template-filters.php",
      "php tests/header-search-icon-color.php",
      "php tests/mini-dropdown-styles.php",
      "php tests/related-posts-renderer.php",
      "php tests/share-urls.php",
      "php tests/single-post-template.php"
    ]
  }
}
