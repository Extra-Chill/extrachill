{
  "auto_cleanup": false,
  "changelog_target": "docs/CHANGELOG.md",
  "extensions": {
    "wordpress": {
      "settings": {
        "phpunit_no_tests": "fail"
      }
    }
  },
  "id": "extrachill",
  "remote_path": "wp-content/themes/extrachill",
  "version_targets": [
    {
      "file": "style.css",
      "pattern": "(?m)^\\s*Version:\\s*([0-9.]+)"
    },
    {
      "file": "package.json",
      "pattern": "\"version\":\\s*\"([0-9.]+)\""
    }
  ]
}