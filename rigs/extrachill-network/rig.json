{
  "id": "extrachill-network",
  "description": "Disposable Extra Chill 11-site subdomain multisite network fixture in WP Codebox",
  "lifecycle": { "mode": "disposable" },
  "resources": {
    "exclusive": ["extrachill-network:${env.HOMEBOY_ARTIFACT_ROOT}"]
  },
  "pipeline": {
    "up": [
      {
        "kind": "requirement",
        "executable": "node",
        "remediation": "Install Node.js 18 or newer"
      },
      {
        "kind": "requirement",
        "executable": "wp-codebox",
        "executable_env": "HOMEBOY_WP_CODEBOX_BIN",
        "remediation": "Install WP Codebox or set HOMEBOY_WP_CODEBOX_BIN"
      },
      {
        "kind": "command",
        "label": "boot the disposable Extra Chill network",
        "command": "node ${package.root}/rigs/extrachill-network/run.mjs",
        "cwd": "${env.PWD}"
      }
    ],
    "check": [
      {
        "kind": "check",
        "label": "validate extrachill-network rig contracts",
        "command": "node ${package.root}/rigs/extrachill-network/tests/contract.test.mjs",
        "cwd": "${package.root}/rigs/extrachill-network"
      },
      {
        "kind": "check",
        "label": "validate generated WP Codebox recipe",
        "command": "node ${package.root}/rigs/extrachill-network/run.mjs --dry-run",
        "cwd": "${env.PWD}"
      }
    ]
  }
}
